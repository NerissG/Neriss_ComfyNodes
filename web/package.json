{
  "version": "0.1.1",
  "name": "Neriss_ComfyNodes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "node scripts/build.ts",
    "check:release": "node scripts/check-release.ts",
    "version:bump": "node scripts/bump-version.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "preview:editor": "vite --config vite.preview.config.ts",
    "test:e2e": "node scripts/browser-tests.ts",
    "test:browser-env": "node scripts/browser-tests.ts --preflight"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-css-injected-by-js": "5.0.2"
  },
  "dependencies": {
    "neverthrow": "8.2.0",
    "zod": "4.6.7"
  }
}
